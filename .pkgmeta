# Stage the repository, then put both required addons at the ZIP root.
package-as: SatchelSense
enable-nolib-creation: no
move-folders:
    SatchelSense/SatchelSense: SatchelSense
    SatchelSense/PocketBuffs: PocketBuffs
manual-changelog:
    filename: SatchelSense/RELEASE-NOTES.md
    markup-type: markdown
ignore:
    - Branding
    - backups
    - dist
    - node_modules
    - release
    - scripts
    - tests
    - LICENSE.txt
    - NAMES.md
    - README.md
    - RESEARCH.md
    - package.json
    - package-lock.json
