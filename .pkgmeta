# Stage the repository, then put both required addons at the ZIP root.
package-as: BagBuffs
enable-nolib-creation: no
move-folders:
    BagBuffs/BagBuffs: BagBuffs
    BagBuffs/PocketBuffs: PocketBuffs
    BagBuffs/SatchelSense: SatchelSense
manual-changelog:
    filename: BagBuffs/RELEASE-NOTES.md
    markup-type: markdown
ignore:
    - Branding
    - backups
    - dist
    - node_modules
    - release
    - scripts
    - tests
    - TESTING-UI.md
    - LICENSE.txt
    - NAMES.md
    - README.md
    - RESEARCH.md
    - package.json
    - package-lock.json
